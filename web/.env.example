# ==============================================================================
# PaidX Web (Landing Page) Environment Variables
# ==============================================================================

# Supabase Project URL (found in Supabase Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon API Key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase Secret / Service Role Key (used securely on server-side API routes to store emails)
SUPABASE_SECRET_KEY=sb_secret_your_key_here

